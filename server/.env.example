[TEMPLATE]
# ProxiSpeak backend — environment variables
#
# Copy to server/.env (or export in your process manager) and fill in real
# values. Never commit a file containing real secrets.
#
# Only variables listed here are read by server/server.js, auth.js, config.js
# and ice.js. Anything else is ignored (not a secret, not a feature flag).

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Origin / CORS / reverse proxy
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins. In production each entry must be a
# bare https: origin (no path, query, wildcard, or trailing slash semantics);
# the server refuses to start otherwise. Development defaults to
# http://localhost:5173 and additionally accepts any loopback http origin
# (useful for `vite preview` on 4173 and the browser test suites).
# CLIENT_ORIGIN=https://proxispeak.example.com,https://www.proxispeak.example.com
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse-proxy hops Express may trust (0-3). Default 0: X-Forwarded-*
# headers are IGNORED, so req.ip and req.secure cannot be spoofed. Set to 1 when
# exactly one reverse proxy (nginx/Caddy/ALB) terminates TLS in front of this
# process, otherwise HTTPS enforcement will reject every token request.
# TRUST_PROXY=1

# Require HTTPS for /api/auth/session, /api/auth/revoke and /api/ice in
# production. Default true. `req.secure` is only meaningful when TRUST_PROXY
# describes the real proxy hop.
# REQUIRE_HTTPS=true

# Escape hatch for an isolated, explicitly trusted http-only pilot. It relaxes
# BOTH the https origin requirement and HTTPS enforcement. Do not use it for an
# internet-facing deployment.
# PROXISPEAK_ALLOW_HTTP_ORIGIN=true

# ---------------------------------------------------------------------------
# Session authentication
# ---------------------------------------------------------------------------
# Required in production, at least 32 characters. Signs short-lived session
# tokens (HMAC-SHA256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development it may be omitted; a clearly-labelled development-only secret is
# used and a warning is printed. NEVER reuse that fallback in production.
# SESSION_SECRET=

# Optional shared join code (>= 12 chars) required by POST /api/auth/session in
# addition to a signed-in account. Ordinary deployments with accounts leave this
# unset.
# JOIN_CODE=

# Allow /api/auth/session to issue a room token WITHOUT an account. This is a
# development/conformance-testing escape hatch only; production refuses to start
# when it is `true`. Accounts are required by default everywhere.
# AUTH_ALLOW_ANONYMOUS=false

# HttpOnly account-session cookie lifetime in seconds (default 604800 = 7 days,
# maximum 2592000 = 30 days). Logout revokes the session immediately.
# ACCOUNT_SESSION_TTL_SECONDS=604800

# Per-IP limits for the account endpoints (10-minute window). Defaults: 60
# signups, 30 login attempts per IP, 10 login attempts per email. Raise them only
# for a browser test suite or a load test; never set them to 0 (0 means default).
# AUTH_SIGNUP_RATE_LIMIT=60
# AUTH_LOGIN_IP_RATE_LIMIT=30
# AUTH_LOGIN_EMAIL_RATE_LIMIT=10

# Session token lifetime in seconds (60-86400, default 3600). Tokens are also
# enforced after connection: a socket is disconnected when its token expires.
# SESSION_TTL_SECONDS=3600

# Optional room allowlist. When set, session issuance and office:join only accept
# these rooms. A session token is bound to one room and cannot join another.
# ALLOWED_ROOMS=design-team,ops

# Optional bearer token that protects GET /api/health. Recommended when the
# health endpoint is reachable outside the private network.
# HEALTH_TOKEN=

# ---------------------------------------------------------------------------
# Accounts / persistence
# ---------------------------------------------------------------------------
# Accounts live in MongoDB when MONGODB_URI is set. Without it the server uses an
# atomic JSON file (`server/.data/users.json` by default) — a real on-disk store
# for local development and single-instance use, not an in-memory fake.
#
# Production requires MongoDB for accounts. A single-instance pilot can opt into
# the file store explicitly with PROXISPEAK_ALLOW_FILE_ACCOUNT_STORE=true.
# ACCOUNT_STORE=mongodb            # mongodb | file
# USER_STORE_FILE=.data/users.json # used only by the file store
# PROXISPEAK_ALLOW_FILE_ACCOUNT_STORE=false

# MongoDB. A watchdog pings the database, retries with backoff, and /api/health
# reports the real state. Credentials in the URI are redacted from every log line.
# If the database is configured but unreachable, account endpoints return 503
# instead of silently writing accounts to the file store.
# MONGODB_URI=mongodb://localhost:27017/proxispeak
# Watchdog interval in milliseconds (default 5000, minimum 1000).
# MONGODB_WATCHDOG_MS=5000
#
# Test-only URI, read by server/db.live.test.js and never by the application.
# Without it the live database tests are skipped instead of failing.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27018

# ---------------------------------------------------------------------------
# ICE / TURN (optional, required behind restrictive NATs)
# ---------------------------------------------------------------------------
# STUN defaults to stun.l.google.com:19302 and stun1.l.google.com:19302.
# STUN_URLS=stun:stun.example.com:3478
#
# TURN relay. Credentials are handed to authenticated clients through GET /api/ice
# and are never compiled into the frontend bundle.
#
# Preferred: ephemeral credentials (coturn use-auth-secret / TURN REST API).
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=
# TURN_TTL_SECONDS=3600
#
# Fallback: static credentials (not recommended for long-lived deployments).
# TURN_USERNAME=
# TURN_CREDENTIAL=
#
# Setting TURN_URLS without credentials is a configuration error: the server
# refuses to start in production rather than silently offering STUN-only.
#
# Relay-only verification. 'all' (default) gathers host/srflx/relay candidates;
# 'relay' forces every candidate pair through TURN, which is how a real relay
# path is proven. 'relay' is rejected unless TURN is configured, because it would
# otherwise produce a connection that can never establish.
# ICE_TRANSPORT_POLICY=all
